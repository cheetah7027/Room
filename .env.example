# ==============================================================================
# ROOM SaaS Environment Configuration
# Compliant with ARCHITECTURE.md & TECH_STACK.md
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Managed PostgreSQL & Authentication
# Required for production database and session persistence
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Transactional Email Gateway (Resend)
# Required for real email delivery to external guest and creator inboxes
# When unset, ROOM operates in verifiable Dev Outbox mode
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="ROOM Experiences <invites@roomplatform.io>"

# WhatsApp Business Platform / Cloud API (P1 Optional)
WHATSAPP_API_TOKEN=your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Environment Mode
NODE_ENV=development
